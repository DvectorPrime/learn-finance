{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curriculum.schema.json",
  "title": "Financial Literacy App - Curriculum JSON",
  "type": "object",
  "required": [
    "$schema_version",
    "meta",
    "conventions",
    "learning_track",
    "evaluation_track",
    "glossary",
    "validation_report"
  ],
  "properties": {
    "$schema_version": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "learning_track": {
      "type": "object",
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "evaluation_track": {
      "type": "object",
      "required": [
        "assessment_types",
        "scoring",
        "pass_and_gating",
        "mastery_model",
        "metrics",
        "assessment_index"
      ],
      "properties": {
        "assessment_index": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assessmentIndexEntry"
          }
        }
      }
    },
    "glossary": {
      "type": "object",
      "required": [
        "concepts"
      ],
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "term",
              "definition"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.]+$"
    },
    "status": {
      "enum": [
        "authored",
        "outline",
        "partial"
      ]
    },
    "difficulty": {
      "enum": [
        "Low",
        "Low-Medium",
        "Medium",
        "Medium-High",
        "High",
        "Very High"
      ]
    },
    "assessmentIndexEntry": {
      "type": "object",
      "required": [
        "id",
        "type",
        "weight"
      ],
      "properties": {
        "type": {
          "enum": [
            "group_quiz",
            "practice_quiz",
            "content_final",
            "challenge",
            "lesson_assessment",
            "module_capstone"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "bullet_list",
            "numbered_list",
            "callout",
            "example",
            "definition",
            "table"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "submodules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "submodules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submodule"
          }
        },
        "capstone": {
          "$ref": "#/$defs/challengeItem"
        }
      }
    },
    "submodule": {
      "type": "object",
      "required": [
        "id",
        "code",
        "title",
        "chapters"
      ],
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "lessons"
      ],
      "properties": {
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "difficulty",
        "contents",
        "evaluation",
        "lesson_assessment"
      ],
      "properties": {
        "difficulty": {
          "$ref": "#/$defs/difficulty"
        },
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content"
          }
        },
        "evaluation": {
          "type": "object",
          "required": [
            "goals",
            "mastery_threshold"
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "id",
        "title",
        "objective",
        "groups",
        "final_quiz"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "final_quiz": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/quizItem"
            }
          ]
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/slideItem"
        },
        {
          "$ref": "#/$defs/slideSetItem"
        },
        {
          "$ref": "#/$defs/caseItem"
        },
        {
          "$ref": "#/$defs/widgetItem"
        },
        {
          "$ref": "#/$defs/quizItem"
        },
        {
          "$ref": "#/$defs/challengeItem"
        }
      ]
    },
    "slideItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "authoring_status"
      ],
      "properties": {
        "kind": {
          "const": "slide"
        },
        "body": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          ]
        }
      }
    },
    "slideSetItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "topics"
      ],
      "properties": {
        "kind": {
          "const": "slide_set"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "caseItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "authoring_status"
      ],
      "properties": {
        "kind": {
          "const": "case_study"
        },
        "scenario": {
          "type": "object",
          "required": [
            "narrative"
          ]
        },
        "prompts": {
          "type": "array"
        }
      }
    },
    "widgetItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "widget_type",
        "authoring_status"
      ],
      "properties": {
        "kind": {
          "const": "widget"
        },
        "widget_type": {
          "enum": [
            "choice_with_reflection",
            "drag_drop_trade",
            "simulation_compare_rounds",
            "allocation_basket",
            "allocation_slider",
            "sort_into_buckets",
            "numeric_calculator",
            "option_comparison",
            "scenario_simulator",
            "choose_path",
            "progress_tracker",
            "tbd"
          ]
        }
      }
    },
    "quizItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "quiz_mode",
        "questions",
        "authoring_status"
      ],
      "properties": {
        "kind": {
          "const": "quiz"
        },
        "quiz_mode": {
          "enum": [
            "group_quiz",
            "practice_quiz",
            "content_final",
            "lesson_final"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "challengeItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "task",
        "rubric"
      ],
      "properties": {
        "kind": {
          "enum": [
            "challenge",
            "capstone"
          ]
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "description",
              "max_score"
            ]
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "single_choice"
            },
            "options": {
              "type": "array",
              "minItems": 2
            },
            "correct": {
              "type": "string"
            }
          },
          "required": [
            "options",
            "correct",
            "explanation"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "true_false"
            },
            "correct": {
              "type": "boolean"
            }
          },
          "required": [
            "correct",
            "explanation"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "numeric"
            },
            "correct": {
              "type": "number"
            }
          },
          "required": [
            "correct",
            "unit",
            "tolerance"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "classify"
            },
            "categories": {
              "type": "array",
              "minItems": 2
            },
            "correct": {
              "type": "string"
            }
          },
          "required": [
            "categories",
            "correct",
            "explanation"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "short_answer"
            },
            "model_answer": {
              "type": "string"
            }
          },
          "required": [
            "model_answer",
            "key_points"
          ]
        }
      ]
    }
  }
}